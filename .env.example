PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (strict CORS allow-list)
CORS_ORIGINS=http://localhost:5000
# Public base URL of this server (used for OAuth callbacks)
BASE_URL=http://localhost:5000
# Where to send the browser after a successful OAuth login
OAUTH_SUCCESS_REDIRECT=/

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Seeds the 3 demo accounts on startup if missing (handy on Render free tier)
AUTO_SEED=false
